# Local development only. Copy to .env; keep real credentials out of Git.
# Compose reads this file only when passed with --env-file.
# The host-run backend receives its environment separately; see backend/README.md.
POSTGRES_DB=makemymarriage
POSTGRES_USER=makemymarriage
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
BACKEND_CONTAINER_PORT=8080
FRONTEND_CONTAINER_PORT=4200

# For the backend shell or IDE. Keep these aligned with the Compose values above.
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/makemymarriage
DATABASE_USERNAME=makemymarriage
DATABASE_PASSWORD=local-development-only
REDIS_HOST=127.0.0.1
SERVER_PORT=8080
# Adopted Milestone 1 inactivity timeout; review deployment policy before production.
SESSION_TIMEOUT=30m

# Stage 1C-A login opt-in. Authentication is independent of public registration.
# AUTHENTICATION_ENABLED=true
# AUTHENTICATION_RATE_LIMIT_KEY=<base64-of-a-private-random-32-byte-key>
# AUTHENTICATION_EMAIL_ATTEMPTS=10
# AUTHENTICATION_IP_ATTEMPTS=60
# AUTHENTICATION_WINDOW_SECONDS=900

# Stage 1D-B local/test-only forgot-password email. Use a fourth independent
# private 32-byte HMAC key; never commit its value.
# PASSWORD_RECOVERY_ENABLED=true
# PASSWORD_RECOVERY_RATE_LIMIT_KEY=<base64-of-another-private-random-32-byte-key>
# PASSWORD_RECOVERY_FRONTEND_URL=http://127.0.0.1:4200/reset-password
# PASSWORD_RECOVERY_COOLDOWN_SECONDS=300
# PASSWORD_RECOVERY_EMAIL_DAILY=3
# PASSWORD_RECOVERY_IP_HOURLY=30
# PASSWORD_RECOVERY_RESET_IP_HOURLY=20
# PASSWORD_RECOVERY_RESPONSE_FLOOR_MS=250

# Stage 1B-D local-only delivery. Set private keys in the backend shell/IDE.
# Keep the AES key stable while pending encrypted jobs exist. Use an independent
# 32-byte random HMAC key for Redis rate-limit key names. Never commit either key.
# EMAIL_OUTBOX_ENABLED=true
# EMAIL_OUTBOX_ACTIVE_KEY_ID=v1
# EMAIL_OUTBOX_KEYS=v1:<base64-of-32-random-bytes>
# VERIFICATION_RATE_LIMIT_KEY=<base64-of-another-32-random-bytes>
# EMAIL_OUTBOX_WORKER_ENABLED=true
# SPRING_MAIL_HOST=127.0.0.1
# SPRING_MAIL_PORT=1025
# MAIL_FROM=hello@makemymarriage.local
# VERIFICATION_FRONTEND_URL=http://127.0.0.1:4200/verify-email
# For optional application containers, set BACKEND_SPRING_PROFILES_ACTIVE=local
# along with the keys and EMAIL_OUTBOX_WORKER_ENABLED=true in ignored .env.
# Their SMTP host is the Compose service name mailpit, not 127.0.0.1.
# BACKEND_SPRING_PROFILES_ACTIVE=local
